{
    "name": "hyperf-apex/apidoc-apifox",
    "description": "Apex Apifox native document export for WebSocket contracts (Hyperf)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "hyperf",
        "swoole",
        "apex",
        "apifox",
        "websocket",
        "documentation"
    ],
    "homepage": "https://github.com/lbg-sys/hyperf-apex-apidoc-apifox",
    "support": {
        "issues": "https://github.com/lbg-sys/hyperf-apex-apidoc-apifox/issues",
        "source": "https://github.com/lbg-sys/hyperf-apex-apidoc-apifox"
    },
    "authors": [
        {
            "name": "lbg-sys",
            "homepage": "https://github.com/lbg-sys"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hyperf-apex/core": "^0.1",
        "hyperf-apex/apidoc": "^0.1",
        "hyperf-apex/websocket": "^0.1"
    },
    "autoload": {
