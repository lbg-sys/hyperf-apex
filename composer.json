{
    "name": "hyperf-apex/apex",
    "description": "Apex generic infrastructure, API engine and components for Hyperf (Metapackage)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "hyperf",
        "swoole",
        "apex",
        "metapackage",
        "openapi"
    ],
    "homepage": "https://github.com/lbg-sys/hyperf-apex",
    "support": {
        "issues": "https://github.com/lbg-sys/hyperf-apex/issues",
        "source": "https://github.com/lbg-sys/hyperf-apex"
    },
    "authors": [
        {
            "name": "lbg-sys",
            "homepage": "https://github.com/lbg-sys"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hyperf-apex/core": "^2.0",
        "hyperf-apex/apidoc": "^2.0",
        "hyperf-apex/apidoc-apifox": "^2.0",
        "hyperf-apex/websocket": "^2.0",
        "hyperf-apex/reliability": "^2.0",
        "hyperf-apex/metrics": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "hyperf/testing": "~3.2.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "swoole/ide-helper": "^6.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Hyperf\\Apex\\": "packages/core/src/",
            "Hyperf\\Apex\\ApiDoc\\": "packages/apidoc/src/",
            "Hyperf\\Apex\\ApiDoc\\Apifox\\": "packages/apidoc-apifox/src/",
            "Hyperf\\Apex\\WebSocket\\": "packages/websocket/src/",
            "Hyperf\\Apex\\Metrics\\": "packages/metrics/src/",
            "Hyperf\\Apex\\Reliability\\": "packages/reliability/src/",
            "Hyperf\\Apex\\RateLimit\\": "packages/reliability/src/RateLimit/",
            "Hyperf\\Apex\\Idempotency\\": "packages/reliability/src/Idempotency/",
            "Hyperf\\Apex\\Outbox\\": "packages/reliability/src/Outbox/",
            "Hyperf\\Apex\\Notify\\": "packages/reliability/src/Notify/",
            "Hyperf\\Apex\\Outbound\\": "packages/reliability/src/Outbound/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyperf\\Apex\\Test\\": "test/"
        }
    },
    "extra": {
        "hyperf": {
            "config": [
                "Hyperf\\Apex\\ConfigProvider",
                "Hyperf\\Apex\\ApiDoc\\ConfigProvider",
                "Hyperf\\Apex\\ApiDoc\\Apifox\\ConfigProvider",
                "Hyperf\\Apex\\WebSocket\\ConfigProvider",
                "Hyperf\\Apex\\Reliability\\ConfigProvider",
                "Hyperf\\Apex\\Metrics\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --colors=always",
        "analyse": "@php vendor/bin/phpstan analyse --configuration phpstan.neon.dist",
        "cs-fix": "@php vendor/bin/php-cs-fixer fix $1"
    }
}
